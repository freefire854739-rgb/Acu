local dropDistance = 7 
local dropSpeed = 8 
local moveSpeed = 18

local platformActive = false
local currentPlatform = nil
local hue = 0
local currentPos = nil
local targetY = nil
local activeTargetX = targetX
local activeTargetZ = targetZ
local hasReachedDestination = false -- NUEVO: Estado para saber si ya llegó horizontalmente
local finalDestinationY = nil       -- NUEVO: Altura original para subir al terminar

local function createPlatform()
	if currentPlatform then currentPlatform:Destroy() end
	local plat = Instance.new("Part")
	plat.Name = "RGB_FarmPlatform"
	plat.Size = Vector3.new(14, 1, 14)
	plat.Anchored = true
	plat.CanCollide = true
	plat.Material = Enum.Material.Neon
	plat.Parent = workspace
	return plat
end

local function togglePlatform(state, customX, customZ)
	platformActive = state
	hasReachedDestination = false
	local character = L_Plr.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	
	if customX and customZ then
		activeTargetX = customX
		activeTargetZ = customZ
	else
		activeTargetX = targetX
		activeTargetZ = targetZ
	end
	
	if platformActive and rootPart then
		finalDestinationY = rootPart.Position.Y -- Guardamos la altura inicial para volver a subir al final
		targetY = rootPart.Position.Y - dropDistance
		currentPos = Vector3.new(rootPart.Position.X, rootPart.Position.Y - 3, rootPart.Position.Z)
	elseif not platformActive then
		if currentPlatform then
			currentPlatform:Destroy()
			currentPlatform = nil
		end
		currentPos = nil
		targetY = nil
		hasReachedDestination = false
	end
end

RunService.RenderStepped:Connect(function(deltaTime)
	if platformActive then
		local character = L_Plr.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		
		if rootPart and currentPos and targetY then
			if not currentPlatform or not currentPlatform.Parent then
				currentPlatform = createPlatform()
			end
			
			if currentPos.Y > targetY and not hasReachedDestination then
				-- Paso 1: Baja
				local newY = math.max(targetY, currentPos.Y - (dropSpeed * deltaTime))
				currentPos = Vector3.new(currentPos.X, newY, currentPos.Z)
			elseif not hasReachedDestination then
				-- Paso 2: Viaja en XZ hacia el depa
				local currentXZ = Vector3.new(currentPos.X, 0, currentPos.Z)
				local targetXZ = Vector3.new(activeTargetX, 0, activeTargetZ)
				
				if (currentXZ - targetXZ).Magnitude > 0.5 then
					local moveDir = (targetXZ - currentXZ).Unit
					local newXZ = currentXZ + (moveDir * moveSpeed * deltaTime)
					currentPos = Vector3.new(newXZ.X, targetY, newXZ.Z)
				else
					currentPos = Vector3.new(activeTargetX, targetY, activeTargetZ)
					hasReachedDestination = true -- ¡Llegó al destino! Activamos el ascenso automático
				end
			else
				-- Paso 3: Sube automáticamente hacia arriba hasta llegar a la altura original
				if finalDestinationY and currentPos.Y < finalDestinationY then
					local newY = math.min(finalDestinationY, currentPos.Y + (dropSpeed * 1.5 * deltaTime))
					currentPos = Vector3.new(activeTargetX, newY, activeTargetZ)
				else
					-- Termino el proceso por completo y se apaga solo
					platformActive = false
					if currentPlatform then
						currentPlatform:Destroy()
						currentPlatform = nil
					end
					currentPos = nil
					targetY = nil
				end
			end
			
			if currentPlatform then
				currentPlatform.Position = currentPos
				rootPart.CFrame = CFrame.new(currentPos.X, currentPos.Y + 3.5, currentPos.Z)
				
				hue = (hue + deltaTime * 0.5) % 1
				currentPlatform.Color = Color3.fromHSV(hue, 1, 1)
			end
		end
	end
end)

