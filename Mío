        Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(1, 0)

        local tStroke = Instance.new("UIStroke", toggleBtn)
        tStroke.Thickness = 1.2

        local function updateState()
            local active = targetTable[targetVar]
            if active then
                toggleBtn.Text = "ON"
                toggleBtn.BackgroundColor3 = AccentYellow
                toggleBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
                tStroke.Color = AccentYellow
            else
                toggleBtn.Text = "OFF"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
                toggleBtn.TextColor3 = TextDark
                tStroke.Color = BorderDark
            end
        end

        updateState()

        toggleBtn.MouseButton1Click:Connect(function()
            targetTable[targetVar] = not targetTable[targetVar]
            updateState()
            if callback then callback(targetTable[targetVar]) end
        end)
    end

